{
  "name": "Agora Você Sabe · Busca de produtos CBS",
  "short_name": "Agora Você Sabe",
  "description": "Busca de produtos CBS por código, nome técnico, referência ou apelido comercial.",
  "lang": "pt-BR",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#312783",
  "icons": [
    {
      "src": "icons/icone-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icone-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icone-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+agoravocesabe",
      "url": "./?abrir=%s"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://danilobuch.github.io/agora-voce-sabe/manifest.webmanifest"
    }
  ]
}
